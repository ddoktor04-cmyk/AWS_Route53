#!/bin/bash
set -ex

# Встановлюємо Apache
apt-get update -y
DEBIAN_FRONTEND=noninteractive apt-get install -y apache2
systemctl enable --now apache2

# Сторінка статичного сайту (контент задає Terraform через шаблон)
cat > /var/www/html/index.html <<EOF
<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>${heading} · hwbarabash1.pp.ua</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Segoe UI', system-ui, sans-serif;
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      color: #e2e8f0;
      padding: 24px;
    }
    .card {
      max-width: 640px;
      width: 100%;
      padding: 44px 40px;
      background: rgba(15, 23, 42, 0.9);
      border: 1px solid #334155;
      border-radius: 18px;
      box-shadow: 0 24px 70px rgba(0, 0, 0, 0.55);
      text-align: center;
    }
    .badge {
      display: inline-block;
      padding: 7px 16px;
      border-radius: 999px;
      border: 1px solid ${accent};
      color: ${accent};
      background: rgba(255, 255, 255, 0.04);
      font-size: 13px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    h1 {
      margin: 20px 0 8px;
      font-size: 2.3rem;
      color: ${accent};
    }
    h2 {
      margin-bottom: 24px;
      font-weight: 500;
      font-size: 1.05rem;
      color: #94a3b8;
    }
    p {
      line-height: 1.65;
      color: #cbd5e1;
      margin-bottom: 14px;
      text-align: left;
    }
    .meta {
      margin-top: 28px;
      padding-top: 18px;
      border-top: 1px solid #334155;
      font-family: ui-monospace, monospace;
      font-size: 0.83rem;
      color: #64748b;
      text-align: left;
    }
    .meta span { color: #94a3b8; }
  </style>
</head>
<body>
  <div class="card">
    <div class="badge">hwbarabash1.pp.ua · latency routing</div>
    <h1>${heading}</h1>
    <h2>${subhead}</h2>
    <p>${note}</p>
    <p>Сервер працює на <b>Apache 2</b> під керуванням <b>Ubuntu 24.04 LTS</b> і віддає статичну сторінку. Amazon Route 53 застосовує <b>latency-based routing</b>: він вимірює затримку «клієнт → регіон» і повертає IP того сервера, до якого дістатись найшвидше.</p>
    <div class="meta">
      hostname: <span>$(hostname)</span><br>
      region: <span>${region_name}</span><br>
      instance type: <span>${instance_kind}</span>
    </div>
  </div>
</body>
</html>
EOF
